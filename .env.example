# Kopier denne filen til .env og fyll inn ÉN av leverandørene under.
# Uten noe oppsett kjører appen i demomodus (mock) med faste eksempler.

# --- Velg leverandør --------------------------------------------------------
# anthropic | openai | gemini | openai_compatible
# Tom = første leverandør med nøkkel, i rekkefølgen anthropic, openai, gemini.
VISION_PROVIDER=

# Valgfritt: overstyr standardmodellen for leverandøren.
#   anthropic: claude-sonnet-5-5   openai: gpt-6-astra   gemini: gemini-3.8-flash
VISION_MODEL=

# --- Nøkler (fyll inn den du har) -------------------------------------------
# Anthropic: console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI: platform.openai.com
OPENAI_API_KEY=
# Google Gemini: aistudio.google.com (en Gemini API-nøkkel, ikke Maps eller Cloud Vision)
GEMINI_API_KEY=

# --- OpenAI-kompatibel tjeneste ---------------------------------------------
# Eksempler:
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1   + nøkkel
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1      (ingen nøkkel)
#   LM Studio:  OPENAI_BASE_URL=http://localhost:1234/v1       (ingen nøkkel)
# Krever VISION_PROVIDER=openai_compatible og VISION_MODEL (en modell som kan lese bilder).
OPENAI_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# mock | live (tom = live hvis en leverandør er satt opp, ellers mock)
VISION_MODE=

# --- Øvrig -------------------------------------------------------------------
DB_PATH=data/lommeur.db
MAX_IMAGE_BYTES=7340032
MAX_IMAGES=6
# Minimum antall salg før et prisintervall regnes som tilstrekkelig
MIN_SALES=5
